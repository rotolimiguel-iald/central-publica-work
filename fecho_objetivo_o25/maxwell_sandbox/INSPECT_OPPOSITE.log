def F1Fecho.OrbitalScreen.fiberLiftMap : (Fiber ≃ₗᵢ[ℂ] Fiber) → ↥H1 →L[ℂ] ↥H1 :=
fun e =>
  ContinuousLinearMap.compLpL 2 (ChatgptAudit.WignerRapidityMeasure016.orbitalMeasure 0)
    e.toLinearIsometry.toContinuousLinearMap
theorem F1Fecho.OrbitalScreen.fiberLiftMap_ae : ∀ (e : Fiber ≃ₗᵢ[ℂ] Fiber) (f : ↥H1),
  ↑↑((fiberLiftMap e) f) =ᵐ[ChatgptAudit.WignerRapidityMeasure016.orbitalMeasure 0] fun p => e (↑↑f p) :=
fun e f => ContinuousLinearMap.coeFn_compLpL e.toLinearIsometry.toContinuousLinearMap f
