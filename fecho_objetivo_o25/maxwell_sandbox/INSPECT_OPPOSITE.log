  ↑↑((fiberLiftMap e) f) =ᵐ[ChatgptAudit.WignerRapidityMeasure016.orbitalMeasure 0] fun p => e (↑↑f p)
F1Fecho.MaxwellGlobal.axisCompactProfile_fiberLift (e : Fiber ≃ₗᵢ[ℂ] Fiber) (h : ↥H1)
