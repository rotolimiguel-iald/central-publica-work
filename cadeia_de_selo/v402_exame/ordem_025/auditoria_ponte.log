TGLExt.PonteDaEscalaDual.momentumScaling : TGLExt.DualScalingData TGLExt.PonteDaEscalaDual.Momentum
def TGLExt.PonteDaEscalaDual.momentumScaling : TGLExt.DualScalingData TGLExt.PonteDaEscalaDual.Momentum :=
{ tau := TGLExt.PonteDaEscalaDual.pPlus, theta := TGLExt.PonteDaEscalaDual.theta,
  scaling := TGLExt.PonteDaEscalaDual.pPlus_scaling }
@TGLExt.DualScalingData.scaling : ∀ {M : Type} (self : TGLExt.DualScalingData M) (s : ℝ) (m : M),
  self.tau (self.theta s m) = Real.exp (-s) * self.tau m
@TGLExt.PonteDaEscalaDual.inertial_momentum_is_zero : ∀ {v : TGLExt.PonteDaEscalaDual.Momentum},
  TGLExt.FalsidadeDaInercia.Inertial TGLExt.PonteDaEscalaDual.momentumScaling v → TGLExt.PonteDaEscalaDual.pPlus v = 0
@TGLExt.PonteDaEscalaDual.invariant_weight_is_zero : ∀ {M : Type} (D : TGLExt.DualScalingData M) (a : M),
  (∀ (s : ℝ), D.tau (D.theta s a) = D.tau a) → D.tau a = 0
TGLExt.PonteDaEscalaDual.rest_energy_eq_mc2 : ∀ (E p m c : ℝ),
  0 < c → 0 ≤ E → 0 ≤ m → E ^ 2 - c ^ 2 * p ^ 2 = m ^ 2 * c ^ 4 → p = 0 → E = m * c ^ 2
@TGLExt.PonteDaEscalaDual.lift_rest_energy : ∀ {M : Type} (D : TGLExt.DualScalingData M) (m : ℝ) (a : M),
  0 < D.tau a →
    0 ≤ m →
      TGLExt.PonteDaEscalaDual.momentum (TGLExt.PonteDaEscalaDual.lift D (m ^ 2) a) = 0 →
        TGLExt.PonteDaEscalaDual.energy (TGLExt.PonteDaEscalaDual.lift D (m ^ 2) a) = m
@TGLExt.PonteDaEscalaDual.lift_mass_not_selected : ∀ {M : Type} (D : TGLExt.DualScalingData M) (a : M),
  D.tau a ≠ 0 → ∀ (u v : ℝ), u ≠ v → TGLExt.PonteDaEscalaDual.lift D u a ≠ TGLExt.PonteDaEscalaDual.lift D v a
@TGLExt.PonteDaEscalaDual.positive_weight_cannot_be_invariant_mass : ∀ {M : Type} (D : TGLExt.DualScalingData M)
  (a : M), 0 < D.tau a → ¬∀ (s : ℝ), D.tau (D.theta s a) = D.tau a
TGLExt.PonteDaEscalaDual.core_positive_realization_exists : ∀ (P : TGLExt.SiteProfile) (mu2 : ℝ),
  0 ≤ mu2 →
    ∃ A,
      0 < TGLExt.PonteDaEscalaDual.pPlus (TGLExt.PonteDaEscalaDual.coreLift P mu2 A) ∧
        TGLExt.PonteDaEscalaDual.massSquared (TGLExt.PonteDaEscalaDual.coreLift P mu2 A) = mu2 ∧
          0 < TGLExt.PonteDaEscalaDual.energy (TGLExt.PonteDaEscalaDual.coreLift P mu2 A)
TGLExt.PonteDaEscalaDual.coreLift : (P : TGLExt.SiteProfile) →
  ℝ → TGLV351.FiniteTracePositive P → TGLExt.PonteDaEscalaDual.Momentum
TGLV351.regularCoreDualScalingData : (P : TGLExt.SiteProfile) → TGLExt.DualScalingData (TGLV351.FiniteTracePositive P)
def TGLExt.PonteDaEscalaDual.theta : ℝ → TGLExt.PonteDaEscalaDual.Momentum → TGLExt.PonteDaEscalaDual.Momentum :=
fun s v => (TGLExt.boost (-s)).mulVec v
def TGLExt.boost : ℝ → Matrix (Fin 2) (Fin 2) ℝ :=
fun s => !![Real.cosh s, Real.sinh s; Real.sinh s, Real.cosh s]
'TGLExt.PonteDaEscalaDual.inertial_momentum_is_zero' depends on axioms: [propext, Classical.choice, Quot.sound]
'TGLExt.PonteDaEscalaDual.core_positive_realization_exists' depends on axioms: [propext, Classical.choice, Quot.sound]

