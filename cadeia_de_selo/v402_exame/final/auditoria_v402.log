@TGLExt.QuedaSemGeometria.a_queda_sem_geometria : ∀ {M : Type} (D : TGLExt.DualScalingData M) {m : M},
  TGLExt.FalsidadeDaInercia.IsPost D m →
    ∀ {β g : ℝ},
      0 < β →
        0 < g →
          ∀ {n : ℕ} {b : ℝ},
            0 < b →
              ∀ (d : Fin n → ℝ),
                (∀ (i : Fin n), 0 ≤ d i) →
                  ∀ (Q : (Fin n → ℝ) →ₗ[ℝ] Fin n → ℝ),
                    (∀ (x : Fin n → ℝ), TGLExt.permanent b d x → Q x = x) →
                      (∀ (x : Fin n → ℝ), (∀ (i : Fin n), d i = 0 → x i = 0) → Q x = 0) →
                        ∀ {G W : Type} [inst : SMul G W] {P : W → Prop} {W₀ : W},
                          TGLExt.QuedaSemGeometria.IsotropicPost G W P W₀ →
                            P W₀ →
                              ((StrictAnti fun s => D.tau (D.theta s m)) ∧
                                  ∀ (s : ℝ), Real.log (D.tau (D.theta s m)) = Real.log (D.tau m) - s) ∧
                                (∀ (s : ℝ),
                                    (D.tau (D.theta s m) < D.tau m ↔ 0 < s) ∧
                                      (D.tau m < D.tau (D.theta s m) ↔ s < 0) ∧
                                        (D.tau (D.theta s m) = D.tau m ↔ s = 0)) ∧
                                  ((∀ (a : ℝ), Real.exp (-a) = 1 ↔ a = 0) ∧
                                      (∀ (a : ℝ), D.tau (D.theta a m) = 1 ↔ a = 0) ∧
                                        (∀ (s : ℝ), 0 < D.tau (D.theta s m)) ∧
                                          ∀ (ε : ℝ), 0 < ε → ∃ s, D.tau (D.theta s m) < ε) ∧
                                    ((∀ (t : ℝ), 0 < t → 0 < t * β * g ∧ Real.exp (-(t * β * g)) < 1) ∧
                                        (∀ (t : ℝ),
                                            0 < t →
                                              0 < D.tau m - D.tau (D.theta (t * β * g) m) ∧
                                                D.tau m - D.tau (D.theta (t * β * g) m) < D.tau m) ∧
                                          ∀ (ε : ℝ), 0 < ε → ∃ t, 0 < t ∧ Real.exp (-(t * β * g)) < ε) ∧
                                      ((∀ (x : Fin n → ℝ) (i : Fin n),
                                            Filter.Tendsto (fun t => TGLExt.diagFlow b d t x i) Filter.atTop
                                              (nhds (Q x i))) ∧
                                          ∀ (x : Fin n → ℝ) (i : Fin n),
                                            d i ≠ 0 →
                                              x i ≠ 0 →
                                                Filter.Tendsto (fun t => TGLExt.diagFlow b d t x i) Filter.atTop
                                                    (nhds 0) ∧
                                                  ∀ (t : ℝ), TGLExt.diagFlow b d t x i ≠ 0) ∧
                                        (((∀ (s : ℝ), TGLExt.boost s = 1 → s = 0) ∧
                                              (∀ (θ : ℝ), TGLExt.Smat (θ + 2 * Real.pi) = TGLExt.Smat θ) ∧
                                                ¬∃ L, Filter.Tendsto TGLExt.Smat Filter.atTop (nhds L)) ∧
                                            ¬TGLExt.FullStaticWitness fun t x => Real.exp (-(t * β * g)) * x) ∧
                                          ∀ (w : W), P w
