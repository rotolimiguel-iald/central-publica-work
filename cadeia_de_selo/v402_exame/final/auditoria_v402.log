@TGLExt.EsperancaCondicional.esperanca_condicional_e_nome : ∀ {M Ext : Type} [inst : Ring M] [inst_1 : StarRing M]
  [inst_2 : Algebra ℂ M] [inst_3 : Ring Ext] [inst_4 : StarRing Ext] [inst_5 : Algebra ℂ Ext]
  (D : TGL.TransportData.ConditionalExpectationData M Ext) {θ b : ℝ},
  Real.sin θ ^ 2 = b →
    0 < b →
      TGL.NameIndex.IsPPLowerBound D (Real.sin θ ^ 2) →
        (∀ (lam : ℝ), TGL.NameIndex.IsPPLowerBound D lam → lam ≤ Real.sin θ ^ 2) →
          (∀ (x : Matrix (Fin 2) (Fin 2) ℂ), TGLExt.nameOp TGLExt.Posto.rhoStar x = TGLExt.diagExpect x) ∧
            TGLExt.nameOp TGLExt.Posto.rhoStar 1 = 1 ∧
              ((∀ (x : Matrix (Fin 2) (Fin 2) ℂ),
                    TGLExt.nameOp TGLExt.Posto.rhoStar (TGLExt.nameOp TGLExt.Posto.rhoStar x) =
                      TGLExt.nameOp TGLExt.Posto.rhoStar x) ∧
                  ∀ (θ' : ℝ),
                    TGLExt.projPlus * (TGLExt.projPlus * TGLExt.angFamily θ') = TGLExt.projPlus * TGLExt.angFamily θ') ∧
                (∀ (x y : Matrix (Fin 2) (Fin 2) ℂ),
                    TGLExt.nameOp TGLExt.Posto.rhoStar x = x →
                      TGLExt.nameOp TGLExt.Posto.rhoStar y = y → TGLExt.nameOp TGLExt.Posto.rhoStar (x * y) = x * y) ∧
                  (∀ (d d' : Fin 2 → ℂ) (x : Matrix (Fin 2) (Fin 2) ℂ),
                      TGLExt.nameOp TGLExt.Posto.rhoStar (Matrix.diagonal d * x * Matrix.diagonal d') =
                        Matrix.diagonal d * TGLExt.nameOp TGLExt.Posto.rhoStar x * Matrix.diagonal d') ∧
                    (∀ (x : Matrix (Fin 2) (Fin 2) ℂ),
                        TGLExt.eD * TGLExt.Lmul x * TGLExt.eD =
                          TGLExt.Lmul (TGLExt.nameOp TGLExt.Posto.rhoStar x) * TGLExt.eD) ∧
                      TGL.NameIndex.ppIndex D = 1 / b ∧ TGL.NameIndex.ppIndex D * b = 1
