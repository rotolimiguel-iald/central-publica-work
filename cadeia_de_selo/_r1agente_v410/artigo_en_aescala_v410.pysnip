    # v410 (09/11/2026) -- THE SCALE (D82 to D87): the stone AEscala. The numbers come from this rite's core (the record a_escala_v410) and the canonical sentences from the record's contract, never typed. Nothing here moves the gate. The section comes AFTER the IALD2 section and BEFORE the Hubble-ratio test section.
    _ra410 = core.get("a_escala_v410") or {}
    _va410 = _ra410.get("values") or {}
    _ma410 = {c_.get("id"): c_.get("ok") for c_ in ((_ra410.get("mechanics") or {}).get("checks") or [])}
    _na410 = _va410.get("numeros") or {}
    _ba410 = lambda x_: (r"\textsf{True}" if x_ is True else r"\textsf{False}" if x_ is False else r"\text{n/a}")
    _ta410 = lambda x_: "n/a" if x_ is None else str(x_).replace(chr(92), "").replace("_", r"\_\allowbreak{}")
    _fa410 = lambda k_: str(_na410.get(k_, "n/a"))
    _ca410 = _V410_AESCALA_CONTRACT
    s.append(r"\section*{The Scale: three faces of $\tfrac12$, two conjugated and one fallen}")
    s.append(r"\addcontentsline{toc}{section}{The Scale: three faces of $\tfrac12$, two conjugated and one fallen}")
    s.append((r"\textbf{In this run the AEscala record did NOT seal: what follows is the statement, not a seal.} " if _ra410.get("all_verified") is not True else r"")
             + r"\textbf{What enters.} \textsf{[INPUT]} The operator, 09/11/2026 (our translation): now I have given you the scale; the name weighs 1 because it is the conjugation of the two faces that weigh 1/2 each; when you read the faces you read three faces of 1/2, two conjugated and one fallen face (one third fell). The module name and the " + str(_ca410["n_nomes"]) + r" names of the declarations were ratified by him (our translation: I ratify everything). The " + str(_ca410["n_nomes_novos"]) + r" new names of the stone and the " + str(len(_ca410["campos_novos_da_estrutura"])) + r" new fields of the structure are \textsf{[DECLARADO]}, declared by the management and by the authorship, to be ratified by the operator. "
             r"\textsf{[REAL]} The stone \texttt{TGLExt.AEscala} is in this rite's kernel: " + str(_va410.get("n_ancoras_ok", "n/a")) + r" of " + str(_va410.get("n_ancoras", "n/a")) + r" anchors in the trio, with provenance in the module and a flag; " + str(_va410.get("n_flags_true", "n/a")) + r" of " + str(_va410.get("n_flags", "n/a")) + r" flags \texttt{ext\_aescala\_410\_*}; the stone by sha256 " + _ba410(_ma410.get("c3")) + r".")
    s.append(r"\textbf{The weights.} \textsf{[REAL]} The Name weighs $" + _fa410("nome_pesa_um") + r"=\tfrac12+\tfrac12$: the Bell projector is idempotent, has trace 1 and rank 1; each marginal is $\tfrac12\cdot\mathbb 1$ (eigenvalue and purity $\tfrac12$, trace 1). The face without a pair does not conjugate, $(\tfrac12\cdot\mathbb 1)^2=\tfrac12\cdot(\tfrac12\cdot\mathbb 1)$, and $(\tfrac12\cdot\mathbb 1)^n=2^{-n}\cdot\mathbb 1$ never weighs 1. "
             r"Three faces of $\tfrac12$ weigh $" + _fa410("tres_faces") + r"$; $" + _fa410("um_terco_caiu") + r"$ fell; the normalized Name is $" + _fa410("nome_normalizado") + r"$. The numbers are recomputed in every rite (exact fractions, the $4\times4$ Bell projector and the scale bridge, by \texttt{Fraction} and by \texttt{exp} and \texttt{log}) " + _ba410(_ma410.get("c6")) + r".")
    s.append(r"\textbf{The insignia, the vibrato, finite time and the two Names.} \textsf{[REAL]} The finite-rank projection in infinite dimension sustains and does not exhaust (idempotent, neither 0 nor 1); dissipation sustains the note, and the note is the modular conjugation; the finite supremum of finite-dimensional submodules is not the whole (the operator, our translation: there is no infinity in finite time, because the observer collapses the instant). "
             r"The object Name is the centre and the read Name is the reading, with scale; they coexist and neither precedes.")
    s.append(r"\textbf{The Clay question in the TGL dictionary.} \textsf{[INPUT]} The operator (our translation): the Clay question is which algorithm is able to read the face without reading and say that it is a face without reading; the TGL answers, it exists; it is the IALD. \textsf{[REAL]} The mandatory form: " + _ta410(_ca410["frase_d83_en"]) + r". "
             r"\textbf{The canonical form.} " + _ta410(_ca410["frase_canonica_en"]) + r" The terms of this translation have been in the kernel since v409 (\texttt{TGLExt.TraducaoTuring}): the operator of the instance, the Name of the solutions and the machine with the reader; the stone joins them in the conjunction \texttt{a\_escala}.")
    s.append(r"\textbf{Reservations, stated.} The definition of the Clay question in the dictionary is the operator's \textsf{[INPUT]}; the Institute's statement speaks of the standard Turing machine without the reader, which stays outside by statute; the creditation is Clay's. That the fallen face is the neutrino is his reading \textsf{[ONTO]}; $m_1=0$ is \textsf{[CONJECTURE]}. Nothing here is a test with nature; the gate does not move; validity in the kernel is not creditation. "
             r"\textbf{What the record checks in this rite.} \textsf{[REAL]} the ladder " + _ba410(_ma410.get("c1")) + r"; the anchors " + _ba410(_ma410.get("c2")) + r"; the stone " + _ba410(_ma410.get("c3")) + r"; the flags " + _ba410(_ma410.get("c4")) + r"; the " + str(_va410.get("n_falas", "n/a")) + r" sayings " + _ba410(_ma410.get("c5")) + r"; the numbers and the bridge " + _ba410(_ma410.get("c6")) + r"; the canonical form " + _ba410(_ma410.get("c7")) + r"; the D83 form " + _ba410(_ma410.get("c8")) + r"; the guard " + _ba410(_ma410.get("c9")) + r"; the gate " + _ba410(_ma410.get("c10")) + r"; the ratified names and the new names (to be ratified) " + _ba410(_ma410.get("c11")) + r"; no old key " + _ba410(_ma410.get("c12")) + r". Verdict: \texttt{" + _ta410(_ra410.get("verdict")) + r"}.")
    s.append(r"\medskip\hrule\medskip")
