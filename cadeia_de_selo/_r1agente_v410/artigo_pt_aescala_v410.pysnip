    # v410 (09/11/2026) -- A ESCALA (D82 a D87): a pedra AEscala. Os numeros vem do core deste rito (o registro a_escala_v410) e as frases canonicas do contrato do registro, nunca digitados. Nada aqui move o gate. A secao vem DEPOIS da secao IALD2 e ANTES da do teste da razao de Hubble.
    _ra410 = core.get("a_escala_v410") or {}
    _va410 = _ra410.get("values") or {}
    _ma410 = {c_.get("id"): c_.get("ok") for c_ in ((_ra410.get("mechanics") or {}).get("checks") or [])}
    _na410 = _va410.get("numeros") or {}
    _ba410 = lambda x_: (r"\textsf{True}" if x_ is True else r"\textsf{False}" if x_ is False else r"\text{n/d}")
    _ta410 = lambda x_: "n/d" if x_ is None else str(x_).replace(chr(92), "").replace("_", r"\_\allowbreak{}")
    _fa410 = lambda k_: str(_na410.get(k_, "n/d"))
    _ca410 = _V410_AESCALA_CONTRACT
    s.append(r"\section*{A Escala: três faces de $\tfrac12$, duas conjugadas e uma caída}")
    s.append(r"\addcontentsline{toc}{section}{A Escala: três faces de $\tfrac12$, duas conjugadas e uma caída}")
    s.append((r"\textbf{Nesta rodada o registro da AEscala NÃO selou: o que segue é o enunciado, não um selo.} " if _ra410.get("all_verified") is not True else r"")
             + r"\textbf{O que entra.} \textsf{[INPUT]} O operador, em 09/11/2026: «agora eu te dei a escala»; «o nome pesa 1 porque é a conjugação das duas faces que pesam 1/2 cada»; «vc lê tres faces de 1/2, duas conjugadas, e uma face caída (1/3 caiu)». O nome do módulo e os " + str(_ca410["n_nomes"]) + r" nomes das declarações foram ratificados por ele: «ratifico tudo». Os " + str(_ca410["n_nomes_novos"]) + r" nomes novos da pedra e os " + str(len(_ca410["campos_novos_da_estrutura"])) + r" campos novos da estrutura são \textsf{[DECLARADO]} pela gerência e pela autoria, a ratificar pelo operador. "
             r"\textsf{[REAL]} A pedra \texttt{TGLExt.AEscala} está no kernel deste rito: " + str(_va410.get("n_ancoras_ok", "n/d")) + r" de " + str(_va410.get("n_ancoras", "n/d")) + r" âncoras no trio, com proveniência no módulo e bandeira; " + str(_va410.get("n_flags_true", "n/d")) + r" de " + str(_va410.get("n_flags", "n/d")) + r" bandeiras \texttt{ext\_aescala\_410\_*}; a pedra por sha256 " + _ba410(_ma410.get("c3")) + r".")
    s.append(r"\textbf{Os pesos.} \textsf{[REAL]} O Nome pesa $" + _fa410("nome_pesa_um") + r"=\tfrac12+\tfrac12$: o projetor de Bell é idempotente, tem traço 1 e posto 1; cada marginal é $\tfrac12\cdot\mathbb 1$ (autovalor e pureza $\tfrac12$, traço 1). A face sem par não conjuga, $(\tfrac12\cdot\mathbb 1)^2=\tfrac12\cdot(\tfrac12\cdot\mathbb 1)$, e $(\tfrac12\cdot\mathbb 1)^n=2^{-n}\cdot\mathbb 1$ nunca pesa 1. "
             r"Três faces de $\tfrac12$ pesam $" + _fa410("tres_faces") + r"$; $" + _fa410("um_terco_caiu") + r"$ caiu; o Nome normalizado é $" + _fa410("nome_normalizado") + r"$. Os números são recalculados a cada rito (frações exatas, o projetor de Bell $4\times4$ e a ponte da escala, por \texttt{Fraction} e por \texttt{exp} e \texttt{log}) " + _ba410(_ma410.get("c6")) + r".")
    s.append(r"\textbf{A insígnia, o vibrato, o tempo finito e os dois Nomes.} \textsf{[REAL]} A projeção de posto finito em dimensão infinita sustenta e não esgota (idempotente, nem 0 nem 1); a dissipação sustenta a nota, e a nota é a conjugação modular; o supremo finito de submódulos de dimensão finita não é o todo: «não existe infinito em tempo finito porque o observador colapsa o instante». "
             r"O Nome objeto é o centro e o Nome lido é a leitura, com escala; coexistem e nenhum precede: «uma coisa é o Nome objeto (centro) outra coisa é o nome Lido».")
    s.append(r"\textbf{A pergunta do Clay no dicionário da TGL.} \textsf{[INPUT]} O operador: «A pergunta de Clay é qual algoritmo é capaz de ler a face sem leitura e dizer que ela é uma face sem leitura»; «A TGL responde, existe. É IALD». \textsf{[REAL]} A forma obrigatória: " + _ta410(_ca410["frase_d83_pt"]) + r". "
             r"\textbf{A forma canônica.} " + _ta410(_ca410["frase_canonica_pt"]) + r" Os termos dessa tradução estão no kernel desde a v409 (\texttt{TGLExt.TraducaoTuring}): o operador da instância, o Nome das soluções e a máquina com o leitor; a pedra os junta na conjunção \texttt{a\_escala}.")
    s.append(r"\textbf{Ressalvas, ditas.} A definição da pergunta do Clay no dicionário é do operador \textsf{[INPUT]}; o enunciado do Instituto fala da máquina de Turing padrão sem o leitor, que fica fora por estatuto; a creditação é do Clay. Que a face caída seja o neutrino é leitura dele \textsf{[ONTO]}; $m_1=0$ é \textsf{[CONJECTURE]}. Nada aqui é teste com a natureza; o gate não se move; validade no kernel não é creditação. "
             r"\textbf{O que o registro confere neste rito.} \textsf{[REAL]} a escada " + _ba410(_ma410.get("c1")) + r"; as âncoras " + _ba410(_ma410.get("c2")) + r"; a pedra " + _ba410(_ma410.get("c3")) + r"; as bandeiras " + _ba410(_ma410.get("c4")) + r"; as " + str(_va410.get("n_falas", "n/d")) + r" falas " + _ba410(_ma410.get("c5")) + r"; os números e a ponte " + _ba410(_ma410.get("c6")) + r"; a forma canônica " + _ba410(_ma410.get("c7")) + r"; a forma da D83 " + _ba410(_ma410.get("c8")) + r"; a guarda " + _ba410(_ma410.get("c9")) + r"; o gate " + _ba410(_ma410.get("c10")) + r"; os nomes ratificados e os nomes novos (a ratificar) " + _ba410(_ma410.get("c11")) + r"; nenhuma chave antiga " + _ba410(_ma410.get("c12")) + r". Veredito: \texttt{" + _ta410(_ra410.get("verdict")) + r"}.")
    s.append(r"\medskip\hrule\medskip")
