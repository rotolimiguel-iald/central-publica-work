riemannZeta_neg_nat_eq_bernoulli : ∀ (k : ℕ), riemannZeta (-↑k) = (-1) ^ k * ↑(bernoulli (k + 1)) / (↑k + 1)
@HurwitzZeta.hurwitzZeta_neg_nat : ∀ {k : ℕ} {x : ℝ},
  k ≠ 0 →
    x ∈ Set.Icc 0 1 →
      HurwitzZeta.hurwitzZeta (↑x) (-↑k) =
        -1 / (↑k + 1) * Polynomial.eval (↑x) (Polynomial.map (algebraMap ℚ ℂ) (Polynomial.bernoulli (k + 1)))
@faithful_period_iff : ∀ {kappa period : ℝ},
  kappa ≠ 0 → (AngularQuotientFaithful kappa period ↔ kappa * period = 2 * Real.pi ∨ kappa * period = -(2 * Real.pi))
@reciprocal_temperature : ∀ {kappa period : ℝ},
  0 < kappa → 0 < period → AngularQuotientFaithful kappa period → 1 / period = kappa / (2 * Real.pi)
@positive_faithful_period : ∀ {kappa period : ℝ},
  0 < kappa → 0 < period → AngularQuotientFaithful kappa period → period = 2 * Real.pi / kappa
def ChatgptAudit.PolarPeriod016.AngularQuotientFaithful : ℝ → ℝ → Prop :=
fun kappa period => ∀ (t u : ℝ), Circle.exp (kappa * t) = Circle.exp (kappa * u) ↔ ∃ n, t = u + ↑n * period
@TGLExt.Fundacao.abismo : ∀ {M : Type} (D : TGLExt.DualScalingData M) {m : M},
  0 < D.tau m → ∀ {ε : ℝ}, 0 < ε → ∃ s, D.tau (D.theta s m) < ε
