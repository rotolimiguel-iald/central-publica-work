@TGLExt.DualScalingData.fixed_tau_zero : ∀ {M : Type} (D : TGLExt.DualScalingData M) {s₀ : ℝ},
  0 < s₀ → ∀ {m : M}, D.theta s₀ m = m → D.tau m = 0
@TGLExt.DualScalingData.scaling : ∀ {M : Type} (self : TGLExt.DualScalingData M) (s : ℝ) (m : M),
  self.tau (self.theta s m) = Real.exp (-s) * self.tau m
@TGLExt.Fundacao.nothing_above_bears_a_post : ∀ {M : Type} (D : TGLExt.DualScalingData M) {s : ℝ},
  s ≠ 0 → ∀ {m : M}, D.theta s m = m → D.tau m = 0
TGLExt.Fundacao.the_floor_fixes_the_cut : ∀ (a : ℝ), Real.exp (-a) = 1 ↔ a = 0
@TGLExt.Fundacao.the_fall_never_lands : ∀ {M : Type} (D : TGLExt.DualScalingData M) {m : M},
  0 < D.tau m → ∀ (s : ℝ), 0 < D.tau (D.theta s m)
@TGLExt.Fundacao.abismo : ∀ {M : Type} (D : TGLExt.DualScalingData M) {m : M},
  0 < D.tau m → ∀ {ε : ℝ}, 0 < ε → ∃ s, D.tau (D.theta s m) < ε
TGLExt.Fundacao.oneScaling : TGLExt.DualScalingData ℝ
@TGLExt.beta_forbids_full_static_witness : ∀ {β g : ℝ},
  0 < β → 0 < g → ¬TGLExt.FullStaticWitness fun t x => Real.exp (-(t * β * g)) * x
@TGLExt.leakage_strictly_loses : ∀ {t β g : ℝ}, 0 < t → 0 < β → 0 < g → Real.exp (-(t * β * g)) < 1
@TGLExt.diagFlow : {n : ℕ} → ℝ → (Fin n → ℝ) → ℝ → (Fin n → ℝ) → Fin n → ℝ
@TGLExt.permanent : {n : ℕ} → ℝ → (Fin n → ℝ) → (Fin n → ℝ) → Prop
@TGLExt.observerProj : {n : ℕ} → (Fin n → ℝ) → (Fin n → ℝ) → Fin n → ℝ
@TGLExt.um_is_the_great_attractor : ∀ {n : ℕ} {β : ℝ},
  0 < β →
    ∀ (d : Fin n → ℝ),
      (∀ (i : Fin n), 0 ≤ d i) →
        ∀ (Q : (Fin n → ℝ) →ₗ[ℝ] Fin n → ℝ),
          (∀ (x : Fin n → ℝ), TGLExt.permanent β d x → Q x = x) →
            (∀ (x : Fin n → ℝ), (∀ (i : Fin n), d i = 0 → x i = 0) → Q x = 0) →
              ∀ (x : Fin n → ℝ) (i : Fin n),
                Filter.Tendsto (fun t => TGLExt.diagFlow β d t x i) Filter.atTop (nhds (Q x i))
@TGLExt.the_observer_is_unique : ∀ {n : ℕ} {β : ℝ},
  0 < β →
    ∀ (d : Fin n → ℝ),
      (∀ (i : Fin n), 0 ≤ d i) →
        ∀ (Q : (Fin n → ℝ) →ₗ[ℝ] Fin n → ℝ),
          (∀ (x : Fin n → ℝ), TGLExt.permanent β d x → Q x = x) →
            (∀ (x : Fin n → ℝ), (∀ (i : Fin n), d i = 0 → x i = 0) → Q x = 0) →
              ∀ (x : Fin n → ℝ), Q x = TGLExt.observerProj d x
def TGLExt.Fundacao.oneScaling : TGLExt.DualScalingData ℝ :=
{ tau := id, theta := fun s x => Real.exp (-s) * x, scaling := TGLExt.Fundacao.oneScaling._proof_1 }
def TGLExt.diagFlow : {n : ℕ} → ℝ → (Fin n → ℝ) → ℝ → (Fin n → ℝ) → Fin n → ℝ :=
fun {n} β d t x i => Real.exp (-(t * β * d i)) * x i
@TGLExt.FalsidadeDaInercia.the_inertia_of_a_post_is_false : ∀ {M : Type} (D : TGLExt.DualScalingData M) {m : M},
  TGLExt.FalsidadeDaInercia.IsPost D m → TGLExt.FalsidadeDaInercia.Inertial D m → 1 = 0
@TGLExt.FalsidadeDaInercia.a_post_is_not_inertial : ∀ {M : Type} (D : TGLExt.DualScalingData M) {m : M},
  TGLExt.FalsidadeDaInercia.IsPost D m → ¬TGLExt.FalsidadeDaInercia.Inertial D m
@TGLExt.FalsidadeDaInercia.inertia_is_not_its_own_cause : ∀ {M : Type} (D : TGLExt.DualScalingData M),
