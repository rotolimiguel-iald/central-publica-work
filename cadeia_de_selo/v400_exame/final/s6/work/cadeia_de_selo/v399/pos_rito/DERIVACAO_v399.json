 "o_que_difere_do_molde": {
  "chain": "cabecalho escrito para a v399 (numeros LIDOS de ESPERADOS e PINOS_BN); marcadores dos passos 3 e 9 = selo_pela_propria_tecnologia_v399 e kh_n1_cobertura_v399; passo 0 exige tambem o sidecar, o runtime_v399.py e o acom_conferencias_v399.py; o passo 1 (o conferidor) roda NO LUGAR (cd $PK) e SEM -I, escreve conferencia_rito_v399_POS_RITO.json e a copia byte a byte vai para pos_rito\\conferidor; o resto e' o molde subido (passo 10 SIMPLES v398 -> v399, sem salto, B9; pinos selo_anterior_v398 e kernel_manifesto_anterior_v398; kernel_recibo R3_2; V399_AUTORIZACAO_OPERADOR)",
  "leitura": "quatro registros novos (selo_pela_propria_tecnologia_v399 e declaracao_do_operador_v399 com funcao; cunhagens_v399 e kh_n1_cobertura_v399 por spec); a pedra Testemunho no kernel do rito (bandeira True, composicao no trio, modulo da pedra, contrato e suporte); o selo ACOM conferido contra ESPERADOS[selo_acom] e o um.py do disco; a declaracao (fala == arquivo, ancoras, trava, estatuto e direcao); o SIDECAR (existe, JSON valido, tres objetos == arquivos do Nos por sha256, sem recusas, honestidade); os resumos do selo primario; as quatro inscricoes todas do operador; o quadro do topo segue selado e igual; registros da v398 a v393 seguem selados; linhas [v399], [v398] e [v397] do stdout; a linha final do rito = colapso tipado seguido da linha do sidecar; AVISO da v399 ([selo_acom] inclusive) e de bloco v393 a v398 reprova; a face de Fock vem da base v398 (copia de bytes), nao de ESPERADOS",
  "superficies": "so' o cabecalho e a ancora (a linha do handoff da v398); SEM COMPACTACAO, rc 3 se passar de 195 linhas ou 24.000 B; o saldo e' +1 linha (o gancho da missao SUBSTITUI a velha)",
  "fechar": "o handoff traz os DOIS paragrafos do README/site: o do QUADRO (T.paragrafo_readme, o da v397, com os marcadores da v397) e o NOVO (T.paragrafo_testemunho, verificado por T.verificar_paragrafo_testemunho) e LISTA o sidecar; copia o sidecar e o selo para v399_selo; RECUSA (rc 2) antes de escrever se qualquer um falhar; o manifesto traz os dois e o sidecar",
  "b3_recibo": "so' a subida de versao (a logica do B(n) simples nao muda; o harness a exercita com recibos sinteticos)",
  "harness": "os harness da v398 subidos + regras nomeadas; 83 controles negativos da leitura; paragrafo do quadro com 6 controles e a regra do 4,44 em todo texto; paragrafo novo com 20 controles; direcao do testemunho e citacao verbatim; 5 controles de registrar_mapa; ensaio do MEMORY.md em tres cenarios; o conferidor roda numa copia em arvore, SEM -I; no fechar: controles do resultado pinado, do numero do quadro, do numero do selo ACOM, da direcao invertida, da inscricao da gerencia e do sidecar adulterado ou ausente, e a conferencia dos dois paragrafos e do sidecar nos dois handoffs",
  "textos, registrar_mapa": "AUTORAIS (escritos para o delta da v399; nenhuma marca pendente)"
 },
