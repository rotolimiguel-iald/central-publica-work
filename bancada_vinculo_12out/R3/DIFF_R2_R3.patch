+def _formas(s):
+    """N11/N14: as formas de um texto que as guardas olham: o texto, o NFKC, e o NFKC decomposto sem marcas combinantes (Mn) nem
+    caracteres de formato (Cf, ex.: espaco de largura zero)."""
