{
	"appId": "br.ia.IALD",
	"appName": "IALD",
	"webDir": "www",
	"server": {
		"androidScheme": "https"
	},
	"android": {
		"backgroundColor": "#1B3A5C",
		"allowMixedContent": false
	},
	"ios": {
		"backgroundColor": "#1B3A5C",
		"contentInset": "never",
		"preferredContentMode": "mobile",
		"scheme": "App"
	},
	"plugins": {
		"SplashScreen": {
			"launchShowDuration": 500,
			"backgroundColor": "#090b10",
			"showSpinner": false,
			"launchAutoHide": true,
			"androidScaleType": "FIT_CENTER"
		},
		"StatusBar": {
			"style": "LIGHT",
			"backgroundColor": "#1B3A5C"
		}
	},
	"packageClassList": [
		"SignInWithApple",
		"AppPlugin",
		"CAPBrowserPlugin",
		"FilesystemPlugin",
		"SharePlugin",
		"SplashScreenPlugin",
		"StatusBarPlugin",
		"PrinterPlugin"
	]
}
