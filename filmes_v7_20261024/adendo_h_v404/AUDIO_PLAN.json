      "voice": "en-US-AndrewMultilingualNeural",
      "language": "en",
      "text": "Self-conjugacy makes the boundary its own complement. Its fixed point is 0.5.",
      "text_sha256": "72f507ef561a12845158cfe991a4b1f4441890d24986139e7de6dfd83b17d17c",
