+// Beta waiting indicator: presentation only; no request, polling or retry logic.
+function createBetaWaitIndicator({ document, iconSrc, signal, initialState = 'connecting' }) {
+  const node = document.createElement('div');
+  node.className = 'beta-wait';
+  node.setAttribute('role', 'status');
+  node.setAttribute('aria-live', 'polite');
+  node.setAttribute('aria-atomic', 'true');
+  const orbit = document.createElement('span');
+  orbit.className = 'beta-wait__orbit'; orbit.setAttribute('aria-hidden', 'true');
+  const icon = document.createElement('img');
+  icon.className = 'beta-wait__icon'; icon.src = iconSrc; icon.alt = '';
+  icon.width = 36; icon.height = 36;
+  orbit.appendChild(icon); node.appendChild(orbit);
+  const label = document.createElement('span');
+  label.className = 'beta-wait__status'; node.appendChild(label);
+  const labels = { connecting: 'Enviando pedido.', queued: 'Pedido na fila.',
+    running: 'Resposta em andamento.', recovery: 'Recuperando o mesmo pedido.' };
+  let stopped = false;
+  function stop() {
+    if (stopped) return;
+    stopped = true; node.dataset.state = 'stopped'; node.remove();
+    signal?.removeEventListener('abort', stop);
+  }
+  function setState(state) {
+    if (stopped) return;
+    if (['completed', 'failed', 'cancelled', 'interrupted', 'expired'].includes(state)) { stop(); return; }
+    if (!Object.hasOwn(labels, state) || node.dataset.state === state) return;
+    node.dataset.state = state; label.textContent = labels[state];
+  }
+  setState(initialState);
+  signal?.addEventListener('abort', stop, { once: true });
+  if (signal?.aborted) stop();
+  return { node, setState, stop };
+}
