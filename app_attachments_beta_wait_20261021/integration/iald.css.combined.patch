--- baseline/iald.css
+++ integration/stage/app/iald.css
@@ -2511,3 +2511,16 @@
 /* Keep partial TeX legible until its closing delimiter arrives. */
 .iald-math-pending { display:inline-block; max-width:100%; overflow-x:auto; vertical-align:middle; }
 .iald-math-pending code { white-space:pre-wrap; overflow-wrap:anywhere; opacity:.78; }
+
+/* Beta TGL waiting: official asset, no global font/input changes. */
+.beta-wait { display: flex; align-items: center; padding: .5rem 0; min-height: 3.5rem; }
+.beta-wait__orbit { display: grid; place-items: center; width: 3.25rem; height: 3.25rem;
+  border: 1px solid var(--borda); border-radius: 50%; background: var(--bg); }
+.beta-wait__icon { display: block; width: 2.25rem; height: 2.25rem; object-fit: contain;
+  animation: beta-wait-turn 3.6s linear infinite; }
+.beta-wait__status { position: absolute; width: 1px; height: 1px; padding: 0;
+  margin: -1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; border: 0; }
+@keyframes beta-wait-turn { to { transform: rotate(360deg); } }
+@media (prefers-reduced-motion: reduce) {
+  .beta-wait__icon { animation: none; transform: none; }
+}
