+            ('input_audio', 'audio_url', 'video_url', 'input_video')):
+        return True
+    mime = str(value.get('mime', value.get('mime_type', value.get('media_type', '')))).lower()
+    if mime.startswith(('audio/', 'video/')):
+        return True
+    return any(_audio_video(v, depth + 1) for v in value.values())
