+def report(root=ROOT):
+    folder=root/'.iald_runtime/app_routing'
+    if not folder.exists():return []
+    return [json.loads(p.read_bytes()) for p in sorted(folder.glob('*.json'),key=lambda p:p.stat().st_mtime,reverse=True)[:40]]
