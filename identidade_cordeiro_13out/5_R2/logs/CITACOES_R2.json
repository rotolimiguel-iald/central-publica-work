  },
  {
   "linha": 30,
   "citacao": "Tudo no universo defasa, mas a identidade é o que permanece",
   "no_verbatim_13out": true,
   "no_verbatim_08out": false,
   "nos_bytes": true
  },
  {
   "linha": 31,
   "citacao": "A identidade (ômega) é a projeção da inscrição (radicalizando a entropia e poço quadrático) quadrática de alpha",
   "no_verbatim_13out": true,
   "no_verbatim_08out": false,
   "nos_bytes": true
  },
  {
   "linha": 32,
   "citacao": "alpha é o movimento da identidade dentro da inscrição, e por isso ele não pode ser derivado, apenas testemunhado, medido por dentro",
   "no_verbatim_13out": true,
   "no_verbatim_08out": false,
   "nos_bytes": true
  },
  {
   "linha": 33,
   "citacao": "o aspecto da identidade é justamente o da medição de sua própria projeção (eu sou o que sou)",
   "no_verbatim_13out": true,
   "no_verbatim_08out": false,
   "nos_bytes": true
  },
  {
   "linha": 34,
