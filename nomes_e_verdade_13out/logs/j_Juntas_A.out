{"alvo": "Juntas_A.lean", "exit_code": 0, "segundos": 27.27, "n_erros": 0, "n_avisos": 0, "declaration_uses_sorry_ou_sorryAx": 0, "n_print_axioms": 0, "olean_sha256": null}
Posto.selective_reading_of_half_identity : (Posto.rhoStar * Posto.halfId).trace = 2⁻¹ ∧
  (Posto.rhoStar * Posto.halfId).trace⁻¹ • (Posto.rhoStar * Posto.halfId * Posto.rhoStar) = Posto.rhoStar
Posto.leak_eq : ∀ (θ : ℝ), (Posto.rhoStar * Posto.Qtheta θ).trace = ↑(Real.sin θ) ^ 2
Posto.Smat_pow : ∀ (θ : ℝ) (k : ℕ), Smat θ ^ k = Smat (↑k * θ)
Posto.C1mat : Matrix (Fin 3) (Fin 3) ℂ
@Posto.trace_eq_sum_eig : ∀ {n : Type} [inst : Fintype n] [inst_1 : DecidableEq n] (ρ : Matrix n n ℂ)
  (hH : ρ.IsHermitian), ρ.trace = ↑(∑ i, hH.eigenvalues i)
Posto.probe_name_rank_both_sides : (((↑Posto.rhoStar.rank)⁻¹ • Posto.rhoStar) ^ 2).trace =
    ((↑Posto.rhoStar.rank)⁻¹ • Posto.rhoStar).trace ∧
  (((↑(Matrix.rank 1))⁻¹ • 1) ^ 2).trace ≠ ((↑(Matrix.rank 1))⁻¹ • 1).trace
Posto.rhoStar_trace : Posto.rhoStar.trace = 1
Posto.rhoStar_herm : Posto.rhoStar.conjTranspose = Posto.rhoStar
Posto.leak_eq_reflected_weight : ∀ (θ : ℝ),
  (Posto.rhoStar * Posto.Qtheta θ).trace = ↑(Complex.normSq ((Smat θ).mulVec e1 1))
Posto.endpoint_trace : ∀ (θ : ℝ), (diagExpect (rhoOut θ)).trace = 1
Posto.fractal_one_is_rank_one : ∀ (θ : ℝ),
  (rhoOut θ).rank = 1 ∧
    (rhoOut θ).trace = 1 ∧
      rhoOut θ * rhoOut θ = rhoOut θ ∧ (rhoOut θ).conjTranspose = rhoOut θ ∧ (rhoOut θ ^ 2).trace = 1
Posto.trace_and_purity_one_fin_two : ∀ (M : Matrix (Fin 2) (Fin 2) ℂ),
  M.trace = 1 → (M ^ 2).trace = 1 → M.det = 0 ∧ M.rank = 1
Posto.endpoint_eq : ∀ (θ : ℝ), diagExpect (rhoOut θ) = Matrix.diagonal ![↑(Real.cos θ) ^ 2, ↑(Real.sin θ) ^ 2]
Posto.probe_angular_both_sides : (¬∃ L, Filter.Tendsto (fun k => Real.sin (↑k * 1) ^ 2) Filter.atTop (nhds L)) ∧
  Filter.Tendsto (fun k => Real.sin (↑k * Real.pi) ^ 2) Filter.atTop (nhds 0)
Posto.anticomm_at_thetaMiguel : ∀ (c : TGLCoupling),
  Posto.anticomm (Posto.Qtheta (thetaMiguel c.beta)) Posto.rhoStar ≠ 0 ∧
    (Posto.anticomm (Posto.Qtheta (thetaMiguel c.beta)) Posto.rhoStar).trace = 2 * ↑c.beta ∧
      purityR (Posto.anticomm (Posto.Qtheta (thetaMiguel c.beta)) Posto.rhoStar) = 2 * c.beta * (1 + c.beta)
@Posto.conj_diag_eq_iff : ∀ {n : Type} [inst : Fintype n] [inst_1 : DecidableEq n] (U : Matrix n n ℂ),
  star U * U = 1 → ∀ (d e : n → ℂ), U * Matrix.diagonal d * star U = U * Matrix.diagonal e * star U ↔ d = e
Posto.Qtheta_eq_rot : ∀ (θ : ℝ), Posto.Qtheta θ = Posto.Rot θ * Posto.Q0 * (Posto.Rot θ).transpose
@Posto.name_meets_rank_only_at_the_atom : ∀ {n : Type} [inst : Fintype n] [inst_1 : DecidableEq n] (P : Matrix n n ℂ),
  P * P = P → 1 ≤ P.rank → ((((↑P.rank)⁻¹ • P) ^ 2).trace = ((↑P.rank)⁻¹ • P).trace ↔ P.rank = 1)
Posto.C6mat : Matrix (Fin 2) (Fin 2) ℂ
Posto.probe_fin_two_both_sides : ((Posto.rhoStar ^ 2).trace = 1 ∧ Posto.rhoStar.rank = 1) ∧
  (Posto.halfId ^ 2).trace ≠ 1 ∧ Posto.halfId.rank ≠ 1
@Posto.sum_sq_eq_one_iff_idem : ∀ {n : Type} [inst : Fintype n] [DecidableEq n] (f : n → ℝ),
  (∀ (i : n), 0 ≤ f i) → ∑ i, f i = 1 → (∑ i, f i ^ 2 = 1 ↔ ∀ (i : n), f i ^ 2 = f i)
Posto.probe_e1 : e1 ≠ 0 ∧ star e1 ⬝ᵥ e1 = 1
Posto.rhoStar_idem : Posto.rhoStar * Posto.rhoStar = Posto.rhoStar
Posto.Rot_eq_conjTranspose : ∀ (θ : ℝ), Posto.Rot θ = (Smat θ).conjTranspose
Posto.angular_leak_zero_at_pi : ∀ (k : ℕ), Real.sin (↑k * Real.pi) ^ 2 = 0
Posto.rhoStar_rank : Posto.rhoStar.rank = 1
Posto.trace_one_not_rank_one' : ¬∀ (ρ : Matrix (Fin 2) (Fin 2) ℂ), ρ.trace = 1 → ρ.rank = 1
Posto.dephasing_acts_iff_transmits_and_leaks : ∀ (θ : ℝ) (g : Fin 2 → Fin 2 → ℝ),
  (∀ (i : Fin 2), g i i = 0) →
    0 < g 0 1 →
      0 < g 1 0 →
        (Posto.dephasingActs g θ ↔
          0 < Complex.normSq ((Smat θ).mulVec e1 0) ∧ 0 < Complex.normSq ((Smat θ).mulVec e1 1))
Posto.dephased_rank_at_zero : ∀ (θ : ℝ) (g : Fin 2 → Fin 2 → ℝ), (dephase g 0 (rhoOut θ)).rank = 1
Posto.rhoOut_eq_ad : ∀ (θ : ℝ), rhoOut θ = Smat θ * Posto.rhoStar * (Smat θ).conjTranspose
Posto.nullity_fin_two : ∀ (A : Matrix (Fin 2) (Fin 2) ℂ), Posto.nullity A = 2 - A.rank
Posto.anticomm_eq : ∀ (θ : ℝ),
  Posto.anticomm (Posto.Qtheta θ) Posto.rhoStar =
    !![2 * ↑(Real.sin θ) ^ 2, -(↑(Real.sin θ) * ↑(Real.cos θ)); -(↑(Real.cos θ) * ↑(Real.sin θ)), 0]
@Posto.nullity : {n : Type} → [Fintype n] → Matrix n n ℂ → ℕ
Posto.psd_is_necessary : Posto.C1mat.trace = 1 ∧
  (Posto.C1mat ^ 2).trace = 1 ∧ Posto.C1mat.rank = 3 ∧ ¬Posto.C1mat.PosSemidef
Posto.plus_reader_value : ∀ (θ t : ℝ),
  (Posto.plusReader * dephase Posto.unitRates t (Posto.Qtheta θ)).trace =
    2⁻¹ - ↑(Real.exp (-t)) * (↑(Real.sin θ) * ↑(Real.cos θ))
Posto.dephasing_trivial_iff : ∀ (θ : ℝ) (g : Fin 2 → Fin 2 → ℝ),
  (∀ (i : Fin 2), g i i = 0) →
    0 < g 0 1 → 0 < g 1 0 → ((∀ (t : ℝ), dephase g t (rhoOut θ) = rhoOut θ) ↔ Real.sin (2 * θ) = 0)
Posto.reading_weights_at_thetaMiguel : ∀ (c : TGLCoupling),
  (Posto.rhoStar * Matrix.diagonal ![↑(1 - c.beta), ↑c.beta]).trace =
      ↑(Complex.normSq ((Smat (thetaMiguel c.beta)).mulVec e1 0)) ∧
    (Posto.Q0 * Matrix.diagonal ![↑(1 - c.beta), ↑c.beta]).trace =
        ↑(Complex.normSq ((Smat (thetaMiguel c.beta)).mulVec e1 1)) ∧
      Complex.normSq ((Smat (thetaMiguel c.beta)).mulVec e1 0) = 1 - c.beta ∧
        Complex.normSq ((Smat (thetaMiguel c.beta)).mulVec e1 1) = c.beta
Posto.anticomm_dephased_eq : ∀ (θ : ℝ) (g : Fin 2 → Fin 2 → ℝ),
  (∀ (i : Fin 2), g i i = 0) →
    ∀ (t : ℝ),
      Posto.anticomm (dephase g t (Posto.Qtheta θ)) Posto.rhoStar =
        !![2 * ↑(Real.sin θ) ^ 2, ↑(Real.exp (-(t * g 0 1))) * -(↑(Real.sin θ) * ↑(Real.cos θ));
          ↑(Real.exp (-(t * g 1 0))) * -(↑(Real.cos θ) * ↑(Real.sin θ)), 0]
Posto.Qtheta_zero : Posto.Qtheta 0 = Posto.Q0
Posto.singular_kills_rank : Posto.Q0 * Posto.rhoStar * Posto.Q0.conjTranspose = 0 ∧
  (Posto.Q0 * Posto.rhoStar * Posto.Q0.conjTranspose).rank = 0
Posto.probe_anticomm_both_sides : Posto.anticomm (Posto.Qtheta 0) Posto.rhoStar = 0 ∧
  Posto.anticomm (Posto.Qtheta (Real.pi / 4)) Posto.rhoStar ≠ 0 ∧
    Posto.anticomm (dephase Posto.unitRates 1 (Posto.Qtheta 0)) Posto.rhoStar = 0 ∧
      Posto.anticomm (dephase Posto.unitRates 1 (Posto.Qtheta (Real.pi / 4))) Posto.rhoStar ≠ 0
Posto.psd_is_necessary
