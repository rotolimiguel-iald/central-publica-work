    {
      "path": "C:\\IALD\\projetos_pyhton\\IALD\\iald-app\\sincronizar_app.ps1",
      "sha256": "d0a770a90a74b5c06fbc6d2af0c36c92cd6c7135f90810b00b1230dce19fdc17",
      "bytes": 10003,
      "anchors": [
        {
          "line": 2,
          "text": "sincronizar_app.ps1 - copia a interface de app/ para o www/ do Capacitor."
        },
        {
          "line": 4,
          "text": "POR QUE EXISTE (11/09/2026). O capacitor.config.json declara \"webDir\": \"www\","
        },
        {
          "line": 5,
          "text": "mas o www/ so tinha icon.png e o index.html estava FORA dele, na raiz do"
        },
        {
          "line": 7,
          "text": "npx cap sync nunca rodou. Compilado assim, o app abre em tela branca."
        },
        {
          "line": 10,
          "text": "servidor Flask tambem serve para o navegador. O www/ e DERIVADO: nunca edite"
        },
        {
          "line": 17,
          "text": ".\\sincronizar_app.ps1 -ComSync     # copia, confere e roda npx cap sync android"
        },
        {
          "line": 25,
          "text": "$destino = \"C:\\IALD\\projetos_pyhton\\IALD\\iald-app\\www\""
        },
        {
          "line": 29,
          "text": "Write-Host ' SINCRONIZAR interface -> www/ do Capacitor'"
        },
        {
          "line": 41,
          "text": "# ⚠ REPARE NA TERCEIRA LINHA: www/kernel_prompt.js recebe o kernel_prompt_BUNDLE,"
        },
        {
          "line": 43,
          "text": "#    contem a tabela de precos de licenciamento, e o www/ alimenta o APK e o IPA. O app"
        },
        {
          "line": 53,
          "text": "'iald.js'               = 'iald.js'"
        },
        {
          "line": 86,
          "text": "# \"/iald_logo_header.png\", arquivo que nunca entrou no www/. Agora os assets"
        },
        {
          "line": 110,
          "text": "Write-Host (\"  [SOBRA]  {0} existe no www/ e nao na origem (nao apagado)\" -f (\"$pasta/\" + ($rel -replace '\\\\','/')))"
        },
        {
          "line": 120,
          "text": "# (a) todo src/href LOCAL do index.html e todo './img/...' do iald.js tem de"
        },
        {
          "line": 121,
          "text": "#     existir dentro do www/ - senao o app abre com imagem quebrada;"
        },
        {
          "line": 126,
          "text": "$jsTexto = Get-Content (Join-Path $destino 'iald.js') -Raw -Encoding UTF8"
        },
        {
          "line": 134,
          "text": "if (-not (Test-Path $local)) { $faltando += (\"referenciado e ausente no www/: {0}\" -f $ref) }"
        },
        {
          "line": 138,
          "text": "throw 'Asset referenciado ausente ou com caminho absoluto - sync abortado'"
        },
        {
          "line": 143,
          "text": "# Nenhum arquivo do www/ pode conter oferta de licenciamento: dali sai o que vai"
        },
        {
          "line": 144,
          "text": "# DENTRO do APK e do IPA. Se sobrar, o sync para aqui em vez de empacotar."
        },
        {
          "line": 155,
          "text": "throw 'Conteudo comercial no www/ - sync abortado (Guideline 3.1.1)'"
        },
        {
          "line": 157,
          "text": "Write-Host '  [OK]     www/ sem oferta comercial (trava da 3.1.1)'"
        },
        {
          "line": 159,
          "text": "# O index.html tem de estar no webDir, senao o app abre em branco."
        },
        {
          "line": 162,
          "text": "Write-Host '  [OK]     www/index.html presente (webDir valido)'"
        },
        {
          "line": 164,
          "text": "throw 'www/index.html AUSENTE - o app abriria em tela branca'"
        },
        {
          "line": 172,
          "text": "Write-Host '--- npx cap sync (android + ios) ---'"
        },
        {
          "line": 175,
          "text": "& npx cap sync"
        },
        {
          "line": 180,
          "text": "Write-Host (\"cap sync exit={0}\" -f $rc)"
        },
        {
          "line": 183,
          "text": "# iald.js com o da fonte. Contar arquivos nao bastaria: um sync que copia a"
        },
        {
          "line": 185,
          "text": "$fonte = \"C:\\IALD\\projetos_pyhton\\IALD\\app\\iald.js\""
        },
        {
          "line": 199,
          "text": "$alvo = Join-Path $dir 'iald.js'"
        },
        {
          "line": 203,
          "text": "Write-Host (\"  [OK]      {0}: {1} arquivo(s), iald.js sha {2} CONFERE\" -f $nome, $n, $sha.Substring(0,12))"
        },
        {
          "line": 205,
          "text": "Write-Host (\"  [FALHA]   {0}: iald.js DIVERGE da fonte (sha {1})\" -f $nome, $sha.Substring(0,12))"
        },
        {
          "line": 208,
          "text": "Write-Host (\"  [FALHA]   {0}: iald.js nao chegou\" -f $nome)"
        }
      ]
    },
