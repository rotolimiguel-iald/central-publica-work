        },
        {
          "line": 15,
          "text": "curl --fail --show-error --location --retry 3 --proto '=https' --tlsv1.2   \"https://nodejs.org/dist/v${IALD_NODE_VERSION}/${IALD_NODE_BUNDLE}.tar.gz\"   --output \"${IALD_NODE_DIR}/${IALD_NODE_BUNDLE}.tar.gz\""
        },
