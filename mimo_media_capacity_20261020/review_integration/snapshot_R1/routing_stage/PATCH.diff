--- runtime/iald_media_budget.py
+++ routing_stage/iald_media_budget.py
@@ -0,0 +1,526 @@
+"""Pure host media admission. No network, payload transforms or wallet state.
+
+UTF-8 is a conservative TEXT bound; media are estimated from resolved metadata.
+Video uses a local documented-estimator adaptation; legacy images retain their
+existing conservative encoded-text bound, without a new image dependency.
+"""
+import hashlib
+import base64
+import binascii
+import json
+import math
+from decimal import Decimal, ROUND_CEILING, InvalidOperation
+
+VERSION = 'iald.media-budget/v1'
+WINDOW = 1048576
+MAX_OUTPUT = 131072
+OUTPUT_FLOOR = 16384
+MAX_ENCODED_BYTES = 50000000
+MAX_DECODED_BYTES = 37500000
+MAX_PROVIDER_JSON_BYTES = 64000000
+STRUCTURAL_SLACK = 4096 + 128
+MEDIA_SLACK_PERCENT = 20  # Explicit engineering margin, not vendor certainty.
+MEDIA_SLACK_MIN = 256
+VIDEO_DEFAULT = dict(fps=2.0, media_resolution='default')
+VIDEO_SOURCE = 'https://mimo.mi.com/docs/en-US/quick-start/usage-guide/multimodal-understanding/video-understanding#explanation-of-video-token-usage'
+ESTIMATOR_PROVENANCE = 'Adapted from Xiaomi documentation lines 335-411, consulted 2026-10-20; not byte-identical official code'
+_FIELDS = {'image_url':'url', 'input_audio':'data', 'video_url':'url'}
+
+
+class BudgetRefusal(ValueError):
+    pass
+
+
+def _number(value, name, *, positive=True):
+    if type(value) not in (float, int) or not math.isfinite(value) or (value <= 0 if positive else value < 0):
+        raise BudgetRefusal('Invalid '+name)
+    return value
+
+
+def _integer(value, name, *, positive=False):
+    if type(value) is not int or (value <= 0 if positive else value < 0):
+        raise BudgetRefusal('Invalid '+name)
+    return value
+
+
+def text_projection(payload):
+    """Remove encoded bytes ONLY at supported media fields; keep all text/state.
+
+    New typed refs remain intact. Unknown data URI locations refuse; the host
+    still validates/decodes the final bytes and checks refs against metadata.
+    """
+    def visit(value):
+        if type(value) is dict:
+            kind = value.get('type')
+            field = _FIELDS.get(kind)
+            if field:
+                result = {}
+                for key, child in value.items():
+                    if key == kind:
+                        if type(child) is not dict or type(child.get(field)) is not str:
+                            raise BudgetRefusal('Invalid media payload shape')
+                        result[key] = {k:((v if kind=='image_url' else '') if k == field else visit(v)) for k,v in child.items()}
+                    else:result[key] = visit(child)
+                if kind not in result:raise BudgetRefusal('Missing media object')
+                return result
+            return {key:visit(child) for key,child in value.items()}
+        if type(value) is list:return [visit(child) for child in value]
+        if type(value) is str and value.startswith('data:'):
+            raise BudgetRefusal('Unclassified data URI; cannot count as text')
+        return value
+    return visit(payload)
+
+
+def text_bound(payload):
+    return len(json.dumps(text_projection(payload),ensure_ascii=False,allow_nan=False).encode('utf-8'))
+
+
+def _fingerprint(payload):
+    value = text_projection(payload)
+    if type(value) is dict:value = {k:v for k,v in value.items() if k!='max_completion_tokens'}
+    raw = json.dumps(value,sort_keys=True,ensure_ascii=False,allow_nan=False).encode('utf-8')
+    return hashlib.sha256(raw).hexdigest()
+
+
+def _slots(payload):
+    found = []
+    def visit(value):
+        if type(value) is list:
+            for child in value:visit(child)
+        elif type(value) is dict:
+            kind = value.get('type')
+            if kind in ('input_audio','video_url'):
+                found.append({'input_audio':'audio','video_url':'video'}[kind])
+            elif kind in ('iald_media','iald_media_ref'):
+                if value.get('kind') not in ('audio','video'):raise BudgetRefusal('Invalid typed media kind')
+                found.append(value['kind'])
+            else:
+                for child in value.values():visit(child)
+    visit(payload)
+    return found
+
+
+def assert_private_media_destination(payload, provider):
+    """Reject typed/audio/video media for textual executors, before expansion."""
+    if provider != 'mimo' and _slots(payload):
+        raise BudgetRefusal('Private audio/video references and URLs are MiMo-only')
+    return True
+
+
+def validate_policy(policy, *, allowed_resolutions=('default','max')):
+    if type(policy) is not dict or set(policy) != {'fps','media_resolution'}:
+        raise BudgetRefusal('Explicit video policy required')
+    fps = _number(policy['fps'],'fps')
+    if not .1 <= fps <= 10:
+        raise BudgetRefusal('Video sampling outside documented limits')
+    if type(policy['media_resolution']) is not str or policy['media_resolution'] not in allowed_resolutions:
+        raise BudgetRefusal('Unverified media resolution')
+    return dict(policy)
+
+
+def video_audio_tokens(duration):
+    """Audio branch of the documented video estimator (includes special tokens)."""
+    _number(duration,'duration_seconds')
+    steps = int(Decimal(str(duration))*24000)//240+1
+    steps = (steps-1)//2+1
+    steps = (steps+1)//2
+    return (steps+3)//4+2
+
+
+def estimate_video(item, policy):
+    """Local adaptation of the documented estimator; ESTIMATE, not actual usage.
+
+    300 is DEFAULT_MAX_FRAME_TOKEN, never a max-frame count. Temporal patches
+    pair frames, at most 2048. This function only estimates; it does not resize
+    a file, mute audio, execute a decoder, or alter the user-provided payload.
+    """
+    policy = validate_policy(policy)
+    duration = _number(item.get('duration_seconds'),'duration_seconds')
+    h = _integer(item.get('height'),'height',positive=True)
+    w = _integer(item.get('width'),'width',positive=True)
+    frame_product = Decimal(str(duration))*Decimal(str(policy['fps']))
+    raw_frames = int(frame_product.to_integral_value(rounding=ROUND_CEILING))
+    if raw_frames > 2048:
+        raise BudgetRefusal('Full-duration video exceeds 2048 frames at selected FPS; select a lower FPS consistent with intent, or segment explicitly')
+    frames = max(2,((min(raw_frames,2048)+1)//2)*2)
+    max_pixels = (131072*1024*2)//frames
+    if policy['media_resolution']!='max':max_pixels=min(max_pixels,300*1024)
+    max_pixels=max(8192,min(max_pixels,8388608))
+    if min(h,w)<32:
+        if h<w:w,h=int(w*32/h),32
+        else:h,w=int(h*32/w),32
+    height,width=round(h/32)*32,round(w/32)*32
+    if height*width>max_pixels:
+        scale=math.sqrt(h*w/max_pixels)
+        height,width=math.floor(h/scale/32)*32,math.floor(w/scale/32)*32
+    elif height*width<8192:
+        scale=math.sqrt(8192/(h*w))
+        height,width=math.ceil(h*scale/32)*32,math.ceil(w*scale/32)*32
+    grids=frames//2
+    visual=grids*((height//16)*(width//16)//4)
+    visual+=grids*(5 if policy['fps']>2 else 3)+grids*2+2
+    return dict(visual_tokens=visual,sampled_frames=frames,
+        requested_frames=raw_frames,vendor_frame_cap_applied=raw_frames>2048,
+        estimated_frame_width=width,estimated_frame_height=height,
+        per_frame_token_budget_default=300,source=VIDEO_SOURCE)
+
+
+def validate_intent(policy, items, limits):
+    if limits is None:return
+    if type(limits) is not dict or not set(limits)<={'min_fps','require_max_resolution'}:
+        raise BudgetRefusal('Invalid host intent constraints')
+    if 'require_max_resolution' in limits:
+        if type(limits['require_max_resolution']) is not bool:raise BudgetRefusal('Invalid detail constraint')
+        if limits['require_max_resolution'] and policy['media_resolution']!='max':
+            raise BudgetRefusal('User maximum-detail/OCR intent requires max resolution')
+    if 'min_fps' in limits:
+        minimum=_number(limits['min_fps'],'intent_min_fps')
+        if minimum>10 or policy['fps']<minimum:raise BudgetRefusal('Motion intent exceeds proposed FPS')
+        for item in items:
+            if item['kind']=='video' and item['duration_seconds']*minimum>2048:
+                raise BudgetRefusal('Vendor 2048-frame cap cannot satisfy requested temporal detail; no hidden quality loss')
+
+
+def _rate(value):
+    if type(value) not in (str,int,float,Decimal) or type(value) is bool:
+        raise BudgetRefusal('Unknown rate')
+    try:rate = Decimal(str(value))
+    except InvalidOperation:raise BudgetRefusal('Invalid rate') from None
+    if not rate.is_finite() or rate < 0:raise BudgetRefusal('Invalid rate')
+    return rate
+
+
+def estimate_cost(input_tokens, output_tokens, rates):
+    if type(rates) is not dict or set(rates) != {'input','cache_read','output'}:
+        raise BudgetRefusal('Explicit model rates required')
+    incoming, cached, outgoing = (_rate(rates[k]) for k in ('input','cache_read','output'))
+    # No assumed cache hit; preserve an upper estimate even if cache tariff rises.
+    cost = (Decimal(input_tokens)*max(incoming,cached)+Decimal(output_tokens)*outgoing)/1000000
+    return int((cost*1000000000).to_integral_value(rounding=ROUND_CEILING))
+
+
+def _metadata(items):
+    if type(items) is not list:raise BudgetRefusal('Resolved host metadata required')
+    result = []
+    for item in items:
+        if type(item) is not dict:raise BudgetRefusal('Invalid resolved item')
+        key, kind, pin = item.get('id'), item.get('kind'), item.get('sha256')
+        if type(key) is not str or not key or kind not in ('audio','video'):
+            raise BudgetRefusal('Missing media identity/kind')
+        if type(pin) is not str or len(pin)!=64 or any(c not in '0123456789abcdef' for c in pin):
+            raise BudgetRefusal('Missing measured media pin')
+        decoded = _integer(item.get('decoded_bytes'),'decoded_bytes',positive=True)
+        encoded = _integer(item.get('encoded_bytes'),'encoded_bytes',positive=True)
+        if encoded != 4*((decoded+2)//3) or encoded > MAX_ENCODED_BYTES or decoded > MAX_DECODED_BYTES:
+            raise BudgetRefusal('Base64/decoded byte budget or length mismatch')
+        clean = dict(id=key,kind=kind,sha256=pin,decoded_bytes=decoded,encoded_bytes=encoded)
+        if kind in ('audio','video'):
+            clean['duration_seconds'] = _number(item.get('duration_seconds'),'duration_seconds')
+        if kind == 'video':
+            clean['width'] = _integer(item.get('width'),'width',positive=True)
+            clean['height'] = _integer(item.get('height'),'height',positive=True)
+        if kind == 'video':
+            if type(item.get('has_audio')) is not bool:raise BudgetRefusal('Video audio-stream metadata required')
+            clean['has_audio'] = item['has_audio']
+        result.append(clean)
+    return result
+
+
+def plan_request(payload, items, *, rates, policy=None, visual_estimator=None,
+                 estimator_source=None, allowed_resolutions=('default','max'), intent_limits=None,
+                 maximum_output=MAX_OUTPUT, context_limit=WINDOW,
+                 group_remaining_usd=None, provider_remaining_usd=None):
+    """Estimate complete current request without modifying body/history.
+
+    visual_estimator(item, policy) returns visual_tokens and sampled_frames
+    (video only). Host owns the estimator and proves its source separately.
+    Audio-track tokens are added here, so visual_tokens must exclude audio.
+    """
+    _integer(maximum_output,'maximum_output',positive=True)
+    _integer(context_limit,'context_limit',positive=True)
+    if not OUTPUT_FLOOR <= maximum_output <= MAX_OUTPUT or context_limit > WINDOW:
+        raise BudgetRefusal('Model output/context outside verified limits')
+    metadata = _metadata(items)
+    if sorted(_slots(payload)) != sorted(item['kind'] for item in metadata):
+        raise BudgetRefusal('Every transmitted media occurrence requires resolved metadata, including history')
+    typed = []
+    def ref_ids(value):
+        if type(value) is list:
+            for child in value:ref_ids(child)
+        elif type(value) is dict:
+            if value.get('type') in ('iald_media','iald_media_ref'):
+                typed.append((value.get('media_ref'),value.get('kind')))
+            else:
+                for child in value.values():ref_ids(child)
+    ref_ids(payload)
+    available=[(item['id'],item['kind']) for item in metadata]
+    for identity in typed:
+        if identity not in available:raise BudgetRefusal('Typed reference differs from resolved host metadata')
+        available.remove(identity)
+    video_policy = validate_policy(policy if policy is not None else VIDEO_DEFAULT,
+                                   allowed_resolutions=allowed_resolutions)
+    validate_intent(video_policy,metadata,intent_limits)
+    text = text_bound(payload)
+    rows = []
+    tokens = 0
+    for item in metadata:
+        visual = 0
+        sampled = None
+        if item['kind'] == 'video':
+            if Decimal(str(item['duration_seconds']))*Decimal(str(video_policy['fps'])) > 2048:
+                raise BudgetRefusal('Full-duration video exceeds 2048 frames at selected FPS; lower FPS consistently with intent, or segment explicitly')
+            estimator=visual_estimator or estimate_video
+            estimate = estimator(dict(item),dict(video_policy))
+            if type(estimate) is not dict:raise BudgetRefusal('Invalid visual estimator result')
+            visual = _integer(estimate.get('visual_tokens'),'visual_tokens',positive=True)
+            sampled = _integer(estimate.get('sampled_frames'),'sampled_frames',positive=True)
+            if sampled > 2048:raise BudgetRefusal('Estimator exceeded vendor frame limit')
+        audio = 0
+        if item['kind']=='audio':
+            audio = int((Decimal(str(item['duration_seconds']))*Decimal('6.25')).to_integral_value(rounding=ROUND_CEILING))
+        elif item.get('has_audio'):
+            audio = video_audio_tokens(item['duration_seconds'])
+        tokens += visual+audio
+        row=dict(item,visual_tokens=visual,audio_tokens=audio,sampled_frames=sampled)
+        if item['kind']=='video':
+            row.update({key:value for key,value in estimate.items() if key not in ('visual_tokens','source')})
+        rows.append(row)
+    slack = max(MEDIA_SLACK_MIN,(tokens*MEDIA_SLACK_PERCENT+99)//100) if metadata else 0
+    input_bound = text+tokens+slack+STRUCTURAL_SLACK
+    output = min(maximum_output,context_limit-input_bound)
+    if output < OUTPUT_FLOOR:
+        raise BudgetRefusal('Context exhausted with full text/history; nothing truncated or dispatched')
+    nano = estimate_cost(input_bound,output,rates)
+    wire_bound = text+sum(item['encoded_bytes']+1024 for item in metadata)
+    if wire_bound > MAX_PROVIDER_JSON_BYTES:
+        raise BudgetRefusal('Expanded provider JSON exceeds byte budget')
+    result = dict(version=VERSION,status='ESTIMADO',text_tokens_bound=text,text_body_sha256=_fingerprint(payload),
+        media_tokens_estimate=tokens,media_slack_tokens=slack,structural_slack_tokens=STRUCTURAL_SLACK,
+        input_tokens_bound=input_bound,output_reserved_tokens=output,
+        output_requested_tokens=maximum_output,output_reduced_technically=output<maximum_output,
+        context_limit=context_limit,context_total=input_bound+output,
+        wire_bytes_upper_estimate=wire_bound,policy=video_policy,items=rows,
+        estimator_source=estimator_source or ESTIMATOR_PROVENANCE,media_slack_percent=MEDIA_SLACK_PERCENT,
+        reservation_nanousd=nano,reservation_usd=nano/1000000000,
+        cache_basis='no_cache_hit_assumed; actual_cache_only_after_usage',
+        group_notice='Reservation remains subject to existing shared group/provider limits; no new task admission or balance check here',
+        quality_notice='Auto JEV is authorized to select explicit policies per request; host enforces intent constraints, vendor sampling cap and final payload. No new user confirmation or silent text/history truncation')
+    result['group_estimate_notices']=group_notice(result,group_remaining_usd=group_remaining_usd,
+                                                 provider_remaining_usd=provider_remaining_usd)
+    return result
+
+
+def validate_final_wire_bytes(actual_bytes):
+    """Host calls on the ACTUAL expanded JSON before any single provider POST."""
+    _integer(actual_bytes,'final_provider_json_bytes',positive=True)
+    if actual_bytes > MAX_PROVIDER_JSON_BYTES:
+        raise BudgetRefusal('Actual provider JSON exceeds byte budget')
+    return actual_bytes
+
+
+def validate_video_wire_policy(payload, policy):
+    """Before POST, require actual video parts to carry the chosen wire fields.
+
+    max_frames is NOT a wire parameter; 300 refers to default tokens per frame.
+    Host resolves bytes/pins/ownership separately and repeats this each tool turn.
+    """
+    policy=validate_policy(policy)
+    def visit(value):
+        if type(value) is list:
+            for child in value:visit(child)
+        elif type(value) is dict:
+            if value.get('type')=='video_url':
+                if value.get('fps')!=policy['fps'] or value.get('media_resolution')!=policy['media_resolution']:
+                    raise BudgetRefusal('Actual video sampling differs from selected JEV policy')
+                if 'max_frames' in value:raise BudgetRefusal('Undocumented max_frames wire field')
+            else:
+                for child in value.values():visit(child)
+    visit(payload)
+    return True
+
+
+def spending_bound(payload, plan):
+    """Validate host plan at the existing spend boundary; no ledger of our own.
+
+    The caller MUST re-resolve byte hashes/policies in its own authenticated
+    transport. Hash binding detects changed text/tools/history, not authority.
+    """
+    routing_options({'selected':plan})
+    if _fingerprint(payload)!=plan['text_body_sha256'] or text_bound(payload)>plan['text_tokens_bound']:
+        raise BudgetRefusal('Payload changed after media budget; replan locally before dispatch')
+    if payload.get('max_completion_tokens')!=plan['output_reserved_tokens']:
+        raise BudgetRefusal('Output reserve differs from host budget')
+    return plan['input_tokens_bound']
+
+
+def reserve_existing(spending, payload, plan):
+    """One reservation through the existing, coordinator-integrated spend guard.
+
+    No account admission, separate debit, balance check, fallback or settlement
+    is introduced. Existing admitted-task semantics and global limits survive.
+    """
+    bound=spending_bound(payload,plan)
+    return spending.before('mimo',payload,bound,media_plan=plan)
+
+
+def group_notice(plan, *, group_remaining_usd=None, provider_remaining_usd=None):
+    """Inform JEV/admin of escalation, never change limits or stop admitted work."""
+    routing_options({'selected':plan})
+    notices = []
+    cap = Decimal(plan['reservation_nanousd'])/1000000000
+    for name,remaining in (('shared_group',group_remaining_usd),('provider',provider_remaining_usd)):
+        if remaining is None:notices.append(dict(scope=name,status='UNKNOWN_REMAINING'))
+        else:
+            try:remaining=Decimal(str(remaining))
+            except InvalidOperation:raise BudgetRefusal('Invalid remaining budget') from None
+            if not remaining.is_finite():raise BudgetRefusal('Invalid remaining budget')
+            if cap>remaining:notices.append(dict(scope=name,status='ESTIMATED_RESERVATION_EXCEEDS_REMAINING',requires_existing_guard=True))
+            else:notices.append(dict(scope=name,status='ESTIMATE_WITHIN_REMAINING;_GUARD_STILL_REQUIRED'))
+    return notices
+
+
+def routing_options(plans):
+    """Whitelist numbers/parameters for JEV; never forward refs, pins or blobs."""
+    if type(plans) is not dict or not plans:raise BudgetRefusal('Host plans required')
+    projection = {}
+    for name, plan in plans.items():
+        if type(name) is not str or not name or type(plan) is not dict:raise BudgetRefusal('Invalid named host plan')
+        if plan.get('status') == 'REFUSED':continue
+        if plan.get('version') != VERSION or plan.get('status') != 'ESTIMADO':raise BudgetRefusal('Unverified budget version')
+        fields = ('text_tokens_bound','media_tokens_estimate','media_slack_tokens','structural_slack_tokens',
+                  'input_tokens_bound','output_reserved_tokens','context_total','context_limit',
+                  'reservation_nanousd','output_requested_tokens')
+        item = {key:_integer(plan.get(key),key) for key in fields}
+        if (item['context_total'] != item['input_tokens_bound']+item['output_reserved_tokens']
+            or item['context_total']>item['context_limit'] or not OUTPUT_FLOOR<=item['output_reserved_tokens']<=MAX_OUTPUT):
+            raise BudgetRefusal('Inconsistent host budget')
+        item['policy'] = dict(plan['policy'])
+        item['history_media'] = [{key:row[key] for key in ('kind','duration_seconds','width','height','has_audio','sampled_frames','requested_frames','vendor_frame_cap_applied','estimated_frame_width','estimated_frame_height') if key in row}
+                                 for row in plan['items']]
+        item['cache_basis'] = 'ESTIMATED_NO_HIT_ASSUMED'
+        if 'group_estimate_notices' in plan:
+            notices=plan['group_estimate_notices']
+            allowed={'UNKNOWN_REMAINING','ESTIMATED_RESERVATION_EXCEEDS_REMAINING','ESTIMATE_WITHIN_REMAINING;_GUARD_STILL_REQUIRED'}
+            if type(notices) is not list or any(type(n) is not dict or n.get('scope') not in ('shared_group','provider') or n.get('status') not in allowed for n in notices):
+                raise BudgetRefusal('Invalid shared group estimate notice')
+            item['group_estimate_notices']=[{k:n[k] for k in ('scope','status')} for n in notices]
+        projection[name] = item
+    if not projection:raise BudgetRefusal('No admissible host media plan; no quality reduction or truncation')
+    return projection
+
+
+def policy_question(plans):
+    view = routing_options(plans)
+    return {'type':'choice','instructions':'Select one host-validated explicit media policy for the task. Compare duration, resolution, frame sampling, full history/context and estimated uncached cost. Do not invent options or discard memory. Automatic selection is operator-authorized; host validates intent limits (OCR/max detail/motion), policy and payload without routine user reconfirmation. This choice grants no new consent or wallet admission.',
+            'criteria':{key:json.dumps(value,sort_keys=True,allow_nan=False) for key,value in view.items()}}
+
+
+def resolve_policy(answer, plans):
+    view = routing_options(plans)
+    if type(answer) is not dict or answer.get('type')!='choice':raise BudgetRefusal('Invalid media policy answer')
+    chosen, probs, confidence = answer.get('choice'), answer.get('probabilities'), answer.get('confidence')
+    if chosen not in view or type(probs) is not dict or set(probs)!=set(view):raise BudgetRefusal('Unknown media policy')
+    for number in [confidence,*probs.values()]:
+        _number(number,'media choice probability',positive=False)
+        if number>1:raise BudgetRefusal('Invalid media probability')
+    if confidence<.7 or abs(sum(probs.values())-1)>.02 or probs[chosen]!=max(probs.values()):
+        raise BudgetRefusal('Uncertain media policy; no automatic quality substitution')
+    return chosen
+
+
+def options(payload, items, proposals, **kwargs):
+    """JEV compares explicit host-validated proposals, never hidden transforms."""
+    if type(proposals) is not dict or not proposals:raise BudgetRefusal('Named proposals required')
+    result = {}
+    for name, policy in proposals.items():
+        if type(name) is not str or not name:raise BudgetRefusal('Invalid proposal id')
+        try:result[name] = plan_request(payload,items,policy=policy,**kwargs)
+        except BudgetRefusal as exc:result[name] = dict(status='REFUSED',reason=str(exc))
+    return result
+
+
+def adapt_resolved_metadata(resolved):
+    """Adapter for Cicero's owner-bound resolve_media_metadata return schema.
+
+    Input MUST be the resolver result, not the browser's canonical-looking part.
+    This pure adapter cannot authenticate an owner or reopen/validate a blob.
+    """
+    if type(resolved) is not list:raise BudgetRefusal('Resolved metadata list required')
+    result=[]
+    for row in resolved:
+        if type(row) is not dict or row.get('type')!='iald_media':raise BudgetRefusal('Unsupported backend reference schema')
+        size=_integer(row.get('bytes'),'resolved_bytes',positive=True)
+        upper=_integer(row.get('encoded_bytes_upper'),'encoded_bytes_upper',positive=True)
+        encoded=4*((size+2)//3)
+        if upper!=encoded+128 or upper>MAX_ENCODED_BYTES:
+            raise BudgetRefusal('Backend full-data-URI bound exceeds 50MB or changed schema')
+        item=dict(id=row.get('media_ref'),kind=row.get('kind'),sha256=row.get('sha256'),
+                  decoded_bytes=size,encoded_bytes=encoded,duration_seconds=row.get('duration_seconds'))
+        if row.get('kind')=='video':
+            item.update(width=row.get('width'),height=row.get('height'),has_audio=row.get('has_audio'))
+        result.append(item)
+    return _metadata(result)
+
+
+def legacy_inline_metadata(messages, *, validate_upload):
+    """Legacy-client bridge using Cicero's trusted LOCAL decoder callback.
+
+    No store lookup for inline parts. Signature/MIME/stream/dimension/duration
+    validation belongs to validate_upload(raw,mime), never browser metadata.
+    Old images/text are skipped. Each historical occurrence is included.
+    """
+    if type(messages) is not list or not callable(validate_upload):
