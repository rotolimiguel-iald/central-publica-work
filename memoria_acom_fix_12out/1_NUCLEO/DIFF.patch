+"""Move the v1 per-mutation backups (memory.sqlite3.bak_*) out of the state directory.
+
+Keeps the newest ``--keep`` (default 3) in place; for every other file: SHA-256
+of the source, copy with fsync, SHA-256 of the destination re-read; equal ->
+delete the source and append a MANIFEST.jsonl line; different -> keep the
+source and abort with a visible error. Writes MANIFEST.json at the end. Never
+touches memory.sqlite3, its -journal, snapshots/ or journal/. No network.
+
+    python -X utf8 mover_backups_antigos.py --state C:\\IALD\\MEMORIA_IALD\\state
+        --dest D:\\IALD_ARQUIVO\\MEMORIA_IALD\\backups_ate_20261012 [--keep 3] [--dry-run]
+"""
+from __future__ import annotations
+
+import argparse
+import json
+from pathlib import Path
+import sys
+import time
+
+sys.path.insert(0, str(Path(__file__).resolve().parent / 'lib'))
+
+from iald_memory import snapshots as _snapshots  # noqa: E402
+
+
+def _log(message):
+    print(f'[{time.strftime("%H:%M:%S")}] {message}', file=sys.stderr, flush=True)
+
+
+def main(argv=None):
+    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
+    parser.add_argument('--state', required=True, help='state directory holding the memory.sqlite3.bak_* files')
+    parser.add_argument('--dest', required=True, help='destination directory (another volume, e.g. D:)')
+    parser.add_argument('--keep', type=int, default=3, help='how many of the newest backups stay in place')
+    parser.add_argument('--dry-run', action='store_true', help='list what would move; nothing is copied or deleted')
+    args = parser.parse_args(argv)
+    if args.keep < 0:
+        parser.error('--keep must be >= 0')
+    try:
+        report = _snapshots.archive_legacy_backups(args.state, args.dest, keep=args.keep, dry_run=args.dry_run, log=_log)
+    except Exception as exc:
+        print(json.dumps({'ok': False, 'error': repr(exc)}, ensure_ascii=False, indent=1))
+        return 1
+    report['ok'] = report['failed'] is None
+    print(json.dumps(report, ensure_ascii=False, sort_keys=True, indent=1))
+    return 0 if report['ok'] else 1
+
+
+if __name__ == '__main__':
+    sys.exit(main())
