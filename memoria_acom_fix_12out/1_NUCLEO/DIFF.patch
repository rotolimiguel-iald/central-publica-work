new file mode 100644
index 0000000..cfa6846
--- /dev/null
+++ b/copia/MEMORIA_IALD/migrar_para_delta.py
@@ -0,0 +1,67 @@
+"""Migrate the common memory database from schema v1 to v2 (state by delta).
+
+Dry run by default; ``--apply`` runs the migration. Whole-database byte backup
+(verified) before any change; one transaction; deep verification after.
+Idempotent: a v2 database is only verified. No network, no provider.
+
+    python -X utf8 migrar_para_delta.py --state C:\\IALD\\MEMORIA_IALD\\state [--apply]
+        [--second-copy-dir D:\\IALD_ARQUIVO\\MEMORIA_IALD\\pre_v2] [--receipt RECIBO.json]
+        [--no-deep-after] [--snapshot-archive-dir DIR]
+    python -X utf8 migrar_para_delta.py --state DIR --verify-only [--deep]
+    python -X utf8 migrar_para_delta.py --state DIR --rebuild-from-journal OUT_DIR
+"""
+from __future__ import annotations
+
+import argparse
+import json
+from pathlib import Path
+import sys
+import time
+
+sys.path.insert(0, str(Path(__file__).resolve().parent / 'lib'))
+
+from iald_memory import migrate as _migrate  # noqa: E402
+
+
+def _log(message):
+    print(f'[{time.strftime("%H:%M:%S")}] {message}', file=sys.stderr, flush=True)
+
+
+def main(argv=None):
+    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
+    parser.add_argument('--state', required=True, help='state directory holding memory.sqlite3')
+    parser.add_argument('--apply', action='store_true', help='apply the migration (default: dry run)')
+    parser.add_argument('--second-copy-dir', default=None, help='second verified copy of the pre-migration backup')
+    parser.add_argument('--receipt', default=None, help='write the JSON receipt to this file')
+    parser.add_argument('--no-deep-after', action='store_true', help='skip the deep post-verification (not recommended)')
+    parser.add_argument('--snapshot-archive-dir', default=None, help='override the byte-snapshot archive directory')
+    parser.add_argument('--verify-only', action='store_true', help='only verify a v2 database (no migration)')
+    parser.add_argument('--deep', action='store_true', help='with --verify-only: deep verification')
+    parser.add_argument('--rebuild-from-journal', default=None, metavar='OUT_DIR',
+                        help='rebuild a v2 database into an empty OUT_DIR from <state>/journal')
+    args = parser.parse_args(argv)
+    try:
+        if args.rebuild_from_journal:
+            result = _migrate.rebuild_from_journal(Path(args.state) / 'journal', args.rebuild_from_journal,
+                                                   snapshot_archive_dir=args.snapshot_archive_dir, log=_log)
+        elif args.verify_only:
+            result = {'root': args.state, 'inspect': _migrate.inspect(args.state),
+                      'verify': _migrate._summarize(_migrate.verify_all(
+                          args.state, deep=args.deep, snapshot_archive_dir=args.snapshot_archive_dir))}
+            result['ok'] = all(v['ok'] for v in result['verify'].values())
+        else:
+            result = _migrate.migrate(args.state, apply=args.apply, second_copy_dir=args.second_copy_dir,
+                                      deep_after=not args.no_deep_after,
+                                      snapshot_archive_dir=args.snapshot_archive_dir, log=_log)
+    except Exception as exc:  # visible failure, never a false ok
+        print(json.dumps({'ok': False, 'error': repr(exc)}, ensure_ascii=False, indent=1))
+        return 1
+    text = json.dumps(result, ensure_ascii=False, sort_keys=True, indent=1)
+    if args.receipt:
+        Path(args.receipt).write_text(text + '\n', encoding='utf-8')
+    print(text)
+    return 0 if result.get('ok', True) else 1
+
+
+if __name__ == '__main__':
+    sys.exit(main())
