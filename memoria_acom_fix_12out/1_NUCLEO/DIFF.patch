+                           '--no-color', '--text', '--src-prefix=a/', '--dst-prefix=b/', a, b],
+                          capture_output=True)
+    if proc.returncode not in (0, 1):
+        raise SystemExit(proc.stderr.decode('utf-8', 'replace'))
+    return proc.stdout
