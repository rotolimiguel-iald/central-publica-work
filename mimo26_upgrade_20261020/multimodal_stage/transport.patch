+        total += len(raw)
+        if count > 3 or len(raw) > 8_000_000 or total > 24_000_000:
+            raise ValueError('Image attachment budget exceeded')
+        result.append({'type': 'image_url', 'image_url': {'url': url}})
+    return result
+
